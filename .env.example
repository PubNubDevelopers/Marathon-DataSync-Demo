# Copy to .env.local for local dev. Never commit .env.local.

# Keyset keys from the Admin Portal. These stay on the server: the browser
# gets them at runtime from /api/session, so they're not in the JS bundle.
PUBNUB_PUBLISH_KEY=pub-c-...
PUBNUB_SUBSCRIBE_KEY=sub-c-...

# Secret Key, used only by /api/session to grant Access Manager tokens.
# On Vercel, leave this empty and set PUBNUB_CONNECTOR instead.
PUBNUB_SECRET_KEY=sec-c-...

# Vercel Connect connector UID for the PubNub API-key connector, for example
# pubnub/pacer. When set, /api/session reads the Secret Key from Vercel Connect.
PUBNUB_CONNECTOR=

# Service Integration API key with Read & write on DataSync for this keyset.
# Used only by `npm run setup:class` on your machine. Don't add it to Vercel.
PUBNUB_ADMIN_API_KEY=

# ElevenLabs API key for the runner's headphones voice, used only by /api/voice. Add it to
# Vercel as a sensitive variable. Without it the runner's page falls back to the
# browser's own speech.
ELEVENLABS_API_KEY=
