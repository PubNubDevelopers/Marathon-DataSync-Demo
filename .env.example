# Copy to .env.local for local dev. Never commit .env.local.

# Hosted team demo: set this in Netlify's environment variables (Functions scope).
# The private shared service holds the keys; only scoped tokens and public keys
# reach the browser. Leave blank to run locally with your own keyset below.
ACCESS_MANAGER_URL=

# Local keyset keys from the Admin Portal. The browser gets the public keys
# at runtime from /api/session, so they're not in the JS bundle.
PUBNUB_PUBLISH_KEY=pub-c-...
PUBNUB_SUBSCRIBE_KEY=sub-c-...

# Secret Key, used only by /api/session to grant Access Manager tokens.
# Not needed when ACCESS_MANAGER_URL is set.
PUBNUB_SECRET_KEY=sec-c-...

# Service Integration API key with Read & write on DataSync for this keyset.
# Used only by `npm run setup:class` on your machine. Don't deploy it.
PUBNUB_ADMIN_API_KEY=

# Audio uses the shipped ElevenLabs recordings only. No audio API key is needed.
# Custom written cheers remain text; the app never calls a TTS provider at runtime.

# Optional: a Strava API app for the finish screen's "Upload to Strava".
# Set the app's Authorization Callback Domain to your site's domain. These are
# server-only values; GPX download still works when they are unset.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
