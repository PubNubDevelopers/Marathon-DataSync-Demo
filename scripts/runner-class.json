      { "name": "status", "path": "/status", "valueKind": "string", "projections": [{ "name": "__default__" }, { "name": "phone" }] },
      { "name": "officialKm", "path": "/payload/officialKm", "valueKind": "number", "isNullable": true, "projections": [{ "name": "__default__" }] },
      { "name": "officialSec", "path": "/payload/officialSec", "valueKind": "number", "isNullable": true, "projections": [{ "name": "__default__" }] }
    ]
