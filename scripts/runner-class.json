      { "name": "lat", "path": "/payload/lat", "valueKind": "number", "isNullable": false, "projections": [{ "name": "__default__" }, { "name": "phone" }] },
      { "name": "lng", "path": "/payload/lng", "valueKind": "number", "isNullable": false, "projections": [{ "name": "__default__" }, { "name": "phone" }] },
      { "name": "km", "path": "/payload/km", "valueKind": "number", "isNullable": false, "projections": [{ "name": "__default__" }, { "name": "phone" }] },
      { "name": "paceSec", "path": "/payload/paceSec", "valueKind": "number", "isNullable": true, "projections": [{ "name": "__default__" }, { "name": "phone" }] },
      { "name": "elapsedSec", "path": "/payload/elapsedSec", "valueKind": "number", "isNullable": true, "projections": [{ "name": "__default__" }, { "name": "phone" }] },
