{
  "name": "riverside-marathon-datasync-demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Riverside Marathon: supporters follow a runner live and pin cheers on the course; she hears them in her headphones. PubNub DataSync, Pub/Sub, and Access Manager are the whole backend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup:class": "node --env-file-if-exists=.env.local scripts/setup-class.mjs",
    "check": "node --env-file-if-exists=.env.local scripts/check.mjs",
    "postinstall": "node scripts/copy-map-worker.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:voice": "node scripts/voice-e2e.mjs",
    "test:voice-api": "node scripts/voice-api-test.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.13.0",
    "next": "^16.4.0",
    "pubnub": "^13.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
